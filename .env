# Salin file ini menjadi .env lalu isi.

# Dianjurkan: email Anda, agar OpenAlex/Crossref memberi akses yang lebih stabil.
CONTACT_EMAIL=

# Opsional: kunci API OpenAlex (bila OpenAlex mewajibkan/menyarankan kunci).
OPENALEX_API_KEY=

# Opsional: kunci API Semantic Scholar (tanpa kunci sering kena batas laju).
S2_API_KEY=

# Opsional: token Lens.org untuk pencarian paten (daftar di lens.org).
LENS_TOKEN=
